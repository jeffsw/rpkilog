#!/usr/bin/env bash
#MISE description="terraform fmt -check + init -backend=false + validate for every root and module"
set -euo pipefail
cd "$MISE_PROJECT_ROOT"

# Non-mutating: check formatting (use `mise run fmt` to actually rewrite).
terraform fmt -check -recursive terraform/

# Validate every directory that contains *.tf, discovered dynamically so new roots/modules are
# covered automatically. Each is init'd with -backend=false (no state/credentials) then validated.
while IFS= read -r d; do
    echo "==> validate ${d}"
    terraform -chdir="${d}" init -backend=false -input=false -no-color >/dev/null
    terraform -chdir="${d}" validate -no-color
done < <(find terraform -name '*.tf' -not -path '*/.terraform/*' -exec dirname {} \; | sort -u)
